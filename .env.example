# Senha usada para autenticar o painel. Em produção, use um valor longo e exclusivo.
ADMIN_SECRET="troque-por-uma-senha-forte-e-exclusiva"

# Porta HTTP. Plataformas de hospedagem normalmente definem este valor.
PORT="3000"

# Diretório persistente para o arquivo store.json.
# Em hospedagens efêmeras, aponte para um volume persistente.
DATA_DIR="./data"

NODE_ENV="development"

# Use 1 somente quando a aplicação estiver atrás de um proxy reverso confiável.
TRUST_PROXY="0"
